# Copy this file to .env and replace the example values. Never commit .env.
# Gmail: enable 2-Step Verification and create a Google App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_SSL=false
SMTP_USERNAME=your.email@gmail.com
SMTP_PASSWORD=your16characterapppassword
CONTACT_TO_EMAIL=your.email@gmail.com
# Keep both local Vite origins while developing. In production, use your deployed frontend origin.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
PORT=5000
